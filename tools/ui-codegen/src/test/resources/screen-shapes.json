{
  "specVersion": 1,
  "contract": { "manifestSha256": "bb0373c2c3e95bcc3923c84a160945e17ca57d5c13fd8122f341f1df181bc658" },
  "services": {
    "deviceApproval": {
      "lookup":  { "operation": "authDeviceInfo" },
      "approve": { "operation": "authDeviceApprove" }
    },
    "deviceAudit": {
      "lookup": { "operation": "authDeviceInfo" },
      "deny":   { "operation": "authDeviceDeny" }
    }
  },
  "flows": { "approveDevice": { "entry": "modal", "start": "enterCode" } },
  "screens": {
    "enterCode": {
      "flow": "approveDevice", "source": null,
      "actions": {
        "submit": { "call": "deviceApproval.lookup", "then": { "push": "reviewDevice" } },
        "cancel": { "then": "close" }
      }
    },
    "reviewDevice": {
      "flow": "approveDevice", "source": "deviceApproval.lookup", "usecase": true,
      "actions": {
        "approve": { "call": "deviceApproval.approve", "then": "close" },
        "deny":    { "call": "deviceAudit.deny",       "then": "close" },
        "retry":   { "call": "deviceApproval.lookup" },
        "back":    { "then": "pop" }
      }
    },
    "auditDevice": {
      "flow": "approveDevice", "source": "deviceAudit.lookup",
      "actions": {}
    },
    "leaflet": {
      "flow": "approveDevice", "source": null,
      "actions": { "done": { "then": "close" } }
    }
  }
}
