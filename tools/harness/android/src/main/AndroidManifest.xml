<?xml version="1.0" encoding="utf-8"?>
<!--
  SPFN Mobile — the Android harness manifest.

  INTERNET is the only permission: the harness sends real requests to whatever base URL
  its launch names.

  Cleartext used to be a blanket `usesCleartextTraffic="true"`, and it is now a network
  security configuration that names the hosts instead. Nothing about the run changed —
  the reference server and the verify app both run over plain HTTP on a developer machine
  — but "this app may speak plain HTTP to the machine the server is on" and "this app may
  speak plain HTTP to anything" are different statements, and only the first one is true.
  The file is generated at build time from local.properties, because the host that
  matters is the developer machine's own LAN address and that belongs in no commit
  (tools/harness/android/build.gradle.kts).

  A configuration is honoured from API 24, which is this repository's minSdk, so the
  attribute needs no per-version fallback.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="SPFN Harness"
        android:networkSecurityConfig="@xml/spfn_harness_network_security_config"
        android:supportsRtl="true">

        <activity
            android:name=".HarnessActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
