# Swift / SwiftPM
.build/
.swiftpm/
# A resolution appears only when a consumer or a local build enables the SocialGoogle
# trait. Committing it would pin transitive versions for every consumer, and its
# absence is also evidence: a trait-off build resolves nothing at all.
Package.resolved
*.xcodeproj/
*.xcworkspace/
# XcodeGen writes the harness app's Info.plist and entitlements from
# tools/harness/ios/project.yml, the same way the CocoaPods fixture is written from the
# module graph. The spec is the source; these are its output.
tools/harness/ios/Generated/
# The example app's Info.plist, written by XcodeGen from examples/ios-swiftui/project.yml.
# It sits beside `Generated/` rather than inside it because that directory is
# tools/ui-codegen's and the generator deletes what it did not emit there.
examples/ios-swiftui/Info.plist
# The harness's device configuration: a LAN address and a Google OAuth client id, both
# of which belong to whoever is holding the phone. tools/harness/ios/Harness.xcconfig is
# the tracked half and optionally includes this one.
tools/harness/ios/Local.xcconfig
DerivedData/
*.xcuserstate

# Gradle
.gradle/
build/
local.properties

# One example cell run's evidence: the receipts pulled off the device and the Maestro
# report, written by examples/ui-spec/run-cells.sh into <platform>/<date>/. A run belongs
# to whoever held the device that day; what this repository keeps is the case table and the
# flows, which say what a run must prove. The tracked `.keep` is what lets the runner
# create the directory without deciding whether it may.
examples/ui-spec/receipts/*
!examples/ui-spec/receipts/.keep

# CocoaPods (fixture only; nothing here is a real integration)
Pods/
*.lock

# macOS
.DS_Store

# Never commit credentials or signing material. The validator also fails on these,
# but ignoring them first means an accidental local file cannot be staged by mistake.
*.p12
*.jks
*.keystore
*.mobileprovision
*.pem
*.key
.netrc
.env
.env.*

# Agent-tool state, which belongs to whoever is running the tool rather than to this
# repository. AGENTS.md and CLAUDE.md here were written entirely by one CLI and carried
# nothing hand-written: a contributor who does not run it got sixty lines about a command
# they do not have, and every upgrade of it churned a version stamp. The rules that bind
# a contributor are in CONTRIBUTING.md, which needs no tool to read.
/AGENTS.md
/CLAUDE.md
