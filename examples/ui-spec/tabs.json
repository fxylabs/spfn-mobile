  "contract": { "manifestSha256": "a7cab3c8e98f3d83384693a45b5d1754640529636c193afd54ef116e98e47c1a" },
  "services": {},
  "flows": {
    "itemDetail": { "entry": "push", "start": "item" },
    "profile": { "entry": "push", "start": "profileSummary" },
    "editProfile": { "entry": "modal", "start": "editName" },
    "accountSheet": { "entry": "sheet", "sheet": { "detent": "fit" }, "start": "accountNote" }
  },
  "screens": {
    "item": {
      "flow": "itemDetail",
      "source": null,
      "body": "lorem.short",
      "title": "Item",
      "actions": { "more": { "then": { "push": "itemMore" }, "role": "primary" } }
    },
    "itemMore": {
      "flow": "itemDetail",
      "source": null,
      "body": "lorem.short",
      "title": "More about the item",
      "actions": { "done": { "then": "close", "role": "primary" } }
    },
    "profileSummary": {
      "flow": "profile",
      "source": null,
      "body": "lorem.short",
      "title": "Profile",
      "actions": { "more": { "then": { "push": "profileDetails" }, "role": "primary" } }
    },
    "profileDetails": {
      "flow": "profile",
      "source": null,
      "body": "lorem.short",
      "title": "Profile details",
      "actions": { "done": { "then": "close", "role": "primary" } }
    },
    "editName": {
      "flow": "editProfile",
      "source": null,
      "body": "lorem.short",
      "title": "Edit name",
      "actions": { "done": { "then": "close", "role": "primary" } }
    },
    "accountNote": {
      "flow": "accountSheet",
      "source": null,
      "body": "lorem.sheet",
      "title": "A note on the account",
      "actions": { "done": { "then": "close", "role": "primary" } }
    }
  },
  "tabs": [
    { "id": "home", "title": "Home", "root": "homeList", "flows": ["itemDetail"] },
    { "id": "account", "title": "Account", "root": "accountHome", "flows": ["profile", "editProfile", "accountSheet"] }
  ]
