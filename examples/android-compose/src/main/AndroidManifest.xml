<?xml version="1.0" encoding="utf-8"?>
<!--
  SPFN Mobile — the Compose example app's manifest.

  It declares NO permissions, and INTERNET is the one it used to. There was a path here
  that built a client against a server local.properties named; nothing reached it, because
  this app has no enrolment path of its own and every call that client made was refused for
  want of a key. The menu replaced that path, on the same fake every cell runs on, so this
  app now cannot send whichever way it was launched — which is a stronger statement than
  the one the permission used to sit beside.

  The theme is a SYSTEM one with no action bar. Left unset, an app inherits the platform's
  default, which draws a title bar of its own above the composition: on the 3e emulator
  round every Android screenshot carried an "SPFN Example" strip over the SDK's own header
  where iOS had one header and nothing else. `android:label` still names the app in the
  launcher and in the task switcher; what changed is that no window decoration draws it a
  second time.

  DeviceDefault and not Material or AppCompat, because this repository depends on no design
  system it did not write (decision C2) and either of those would be a new artifact in
  gradle/verification-metadata.xml for a window background. `Light` and not the
  appearance-following variant, because `SpfnTokens` resolves to the same white palette in
  both appearances: a theme that went dark on a dark-mode device would paint
  `FlowHost.cover()` — which reads `android:colorBackground` off the host's theme, and is
  the one attribute every Android theme defines — near-black behind screens that are still
  white.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:label="SPFN Example"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
